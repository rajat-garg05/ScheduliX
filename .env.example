# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=schedulix
DB_USER=schedulix
DB_PASSWORD=schedulix
DB_URL=jdbc:postgresql://localhost:5432/schedulix

# Application
SERVER_PORT=8080
APP_TIMEZONE=Asia/Kolkata
APP_PUBLIC_URL=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev

# Security (use a random 32+ character string in production)
JWT_SECRET=change-me-to-a-long-random-secret-string

# Email (set APP_MAIL_ENABLED=true when using Mailtrap, Brevo, or Gmail SMTP)
APP_MAIL_ENABLED=false
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@schedulix.local